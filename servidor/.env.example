# Linhas comentadas usam o padrão do servidor (ou o que o lsfire.service define). No systemd, o que está neste arquivo
# VALE MAIS que as linhas Environment= do lsfire.service: só descomente o que quiser mudar de verdade.

# Porta interna (atrás do HTTPS/proxy). Padrão 8080.
# PORT=8080
# Endereço em que o servidor escuta. Padrão 127.0.0.1 (só esta máquina: o Caddy repassa). Proxy em outra máquina: 0.0.0.0
# HOST=127.0.0.1
# Senha do primeiro administrador (opcional). Sem ela, o servidor sorteia uma e mostra no console + data/SENHA-INICIAL.txt
# (o arquivo é apagado sozinho quando o administrador troca a senha).
# ADMIN_SENHA_INICIAL=
# Dias que uma sessão continua válida sem uso (o técnico em campo fica offline por dias). Padrão 30.
SESSAO_DIAS=30
# Prazo máximo de uma sessão, mesmo usada todo dia. Padrão 90.
# SESSAO_MAX_DIAS=90
# Token para exportar/backup por script (ex.: cron), enviado no cabeçalho X-Admin-Token. Vazio = desligado.
# Precisa ter 32 caracteres ou mais; gere com:  openssl rand -hex 32
ADMIN_TOKEN=
# Backup automático
BACKUP_INTERVAL_HORAS=6
BACKUP_MANTER=30
# Limite de requisições por IP, por minuto
RATE_LIMIT_MAX=600
# Cookie só por HTTPS: 1 = sempre, 0 = nunca (só para teste local), vazio = segue o protocolo. O lsfire.service já põe 1.
# COOKIE_SECURE=
# De quem aceitar o X-Forwarded-For (endereço real de quem chama). Vazio = só do proxy desta máquina (Caddy). IP do proxy se ele estiver em outra máquina. 0 = de ninguém.
TRUST_PROXY=
