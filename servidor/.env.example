# Porta do servidor (atrás do HTTPS/proxy). Padrão 8080.
PORT=8080
# Senha do primeiro administrador (opcional). Sem ela, o servidor sorteia uma e mostra no console + data/SENHA-INICIAL.txt.
# ADMIN_SENHA_INICIAL=
# Dias que uma sessão continua válida sem uso (o técnico em campo fica offline por dias). Padrão 30.
SESSAO_DIAS=30
# Token para exportar/backup por script (ex.: cron). O administrador logado não precisa dele.
ADMIN_TOKEN=troque-este-token
# Backup automático
BACKUP_INTERVAL_HORAS=6
BACKUP_MANTER=30
# Limite de requisições por IP, por minuto
RATE_LIMIT_MAX=600
# Cookie só por HTTPS: 1 = sempre, 0 = nunca (só para teste local), vazio = segue o protocolo
COOKIE_SECURE=
